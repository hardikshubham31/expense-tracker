DATABASE_URL="postgresql://expense:expense@localhost:5432/expense_tracker?schema=public"

# Better Auth
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (optional). Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Receipts are stored on local disk; point this at a persistent volume in production
# RECEIPTS_DIR="/var/lib/expense-tracker/receipts"
