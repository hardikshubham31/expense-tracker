DATABASE_URL="postgresql://expense:expense@localhost:5432/expense_tracker?schema=public"

# Auth: signs the Google sign-in state cookie (openssl rand -base64 32)
AUTH_SECRET="generate-with: openssl rand -base64 32"
# Public URL of the web app, and where it reaches the API
APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
API_PORT=4000

# Google OAuth (optional). Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Receipts are stored on local disk (apps/api/storage/receipts by default); point this at a persistent volume in production
# RECEIPTS_DIR="/var/lib/expense-tracker/receipts"
